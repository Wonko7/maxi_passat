(* Set static configuration in case you are using static linking only.
   These information are taken from the config file otherwise.
*)

let%server prodpath_or_fallback file fallback_default =
  (* using bin/exe's .. as root *)
  let prod_path =
    Filename.concat @@ Filename.dirname @@ Filename.dirname Sys.argv.(0)
  in
  let pp = prod_path file in
  let res = if Sys.file_exists pp then pp else fallback_default in
  (* too soon for Lwt_log *)
  print_string "static_config: path dicovery, using: ";
  print_endline res;
  res

let%server set_static_config () =
  let port =
      (match Sys.getenv_opt "PORT" with
      | Some p -> int_of_string p
      | None -> 8080)
  in
  let db_port =
      (match Sys.getenv_opt "DBPORT" with
      | Some p -> int_of_string p
      | None -> %%PGPORT%%)
  in
  let db_user =
      (match Sys.getenv_opt "DBUSER", "%%PGUSER%%" with
      | Some u, _ -> u
      | _, u when u = "" -> u
      | _ -> "")
  in
  print_string "DB user: "; print_endline db_user;
  print_string "DB port: "; print_int db_port; print_endline "";
  if not (Ocsigen_config.has_configuration_file ())
  then (
    let js_loc =
      prodpath_or_fallback "var/www/maxi_passat/maxi_passat.js"
        "local/var/www/maxi_passat/maxi_passat.js"
    in
    let css_loc =
      prodpath_or_fallback "var/www/maxi_passat/css/maxi_passat.css"
        "local/var/www/maxi_passat/css/maxi_passat.css"
    in
    Ocsigen_config.set_ports [`All, port];
    Ocsigen_config.set_veryverbose ();
    Ocsigen_config.set_debugmode true;
    Ocsigen_config.set_logdir "local/var/log/maxi_passat";
    Ocsigen_config.set_datadir "local/var/data/maxi_passat";
    Ocsigen_config.set_uploaddir (Some "/tmp");
    Ocsigen_config.set_usedefaulthostname true;
    Ocsigen_config.set_command_pipe "local/var/run/maxi_passat-cmd";
    Ocsigen_config.set_default_charset (Some "utf-8");
    Ocsipersist_settings.set_host "%%PGHOST%%";
    Ocsipersist_settings.set_port db_port;
    Ocsipersist_settings.set_database "ocsipersist_maxi_passat";
    Ocsipersist.init ();
    Maxi_passat_config.os_db_database := Some "%%PGDATABASE%%";
    Maxi_passat_config.os_db_host := Some "%%PGHOST%%";
    Maxi_passat_config.os_db_user := Some db_user;
    Maxi_passat_config.os_db_password := Some "%%PGPASSWORD%%";
    Maxi_passat_config.os_db_port := Some db_port;
    Maxi_passat_config.app_name :=
      Filename.chop_suffix (Unix.readlink js_loc) ".js";
    Maxi_passat_config.css_name := Unix.readlink css_loc)
